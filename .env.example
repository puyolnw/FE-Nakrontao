# Frontend (static SPA served by Caddy). On Railway set these as service variables.

# Railway sets PORT automatically.
PORT=8080

# Where /api and /uploads are forwarded. On Railway use the backend private URL, e.g.
# http://be-nakrontao.railway.internal:8080 (or its public URL if it has one).
# `npm run dev` also reads API_URL for the Vite dev proxy.
API_URL=http://127.0.0.1:18080
